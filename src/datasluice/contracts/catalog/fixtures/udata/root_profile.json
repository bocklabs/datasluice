  "query_schemas": {
    "dataset_catalog": {
      "defaults": {
        "page": 1,
        "page_size": 100
      },
      "repeatable": ["tag"],
      "boolean": ["featured", "archived", "deleted", "private"],
      "choices": {
        "access_type": ["open", "open_with_account", "restricted"]
      }
    },
    "dataset_csv": {
      "defaults": {
        "page": 1,
        "page_size": 20
      },
      "repeatable": ["tag", "granularity", "format", "schema"],
      "boolean": ["featured"],
      "choices": {
        "access_type": ["open", "open_with_account", "restricted"],
        "format_family": ["tabular", "machine_readable", "geographical", "documents", "other"],
        "last_update_range": ["last_30_days", "last_12_months", "last_3_years"],
        "producer_type": ["public-service", "association", "company", "local-authority", "user", "not-specified"]
      }
    },
    "organization_csv": {
      "repeatable": [],
      "scalar": ["q", "badge", "name", "business_number_id"]
    },
    "reuse_csv": {
      "repeatable": ["tag"],
      "scalar": ["q", "sort", "dataset", "dataservice", "organization_badge"]
    },
    "dataservice_csv": {
      "repeatable": ["tag"],
      "scalar": ["q", "sort", "contact_point", "dataset", "organization_badge", "topic", "reuse"]
    }
  },
