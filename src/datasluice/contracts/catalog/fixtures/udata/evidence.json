        "udata/oauth.client-info",
        "udata/oauth.authorize",
        "udata/oauth.oauth-error"
      ],
      "mutation_operations": [
        "udata/oauth.authorize-post",
        "udata/oauth.revoke-token"
      ]
    },
    "observed_stock_semantics": {
      "token": "RFC 6749 form-encoded grant; the disposable stack has no registered client, so the typed status equals the raw 400/401.",
      "revoke": "RFC 7009 answers 200 with an empty body; the typed result never invents a document.",
      "client_info": "login_required in stock, so an API key yields 401 and no consent body is fabricated.",
      "authorize": "login_required in stock; the typed client follows the redirect like the raw probe.",
      "authorize_post": "login_required in stock; the consent POST is compared to its raw status in sync and async, and reports the decision that was sent rather than a fabricated consent",
      "oauth_error": "the 17.6.0 image ships no api/oauth_error.html, so the deployment answers 500 text/html; the typed route returns that page status and media type, never the body"
    },
    "controlled_test_sha256": "c31af07a18573f07f181793ff50da0275bff94cfd173e2e3c6f1add553ee8939",
    "wheel_test_sha256": "170d8eff6510a096a96e90bc70617a659ab259d3a32afccc2d975c12e1477aef",
    "auth_surface_separation": "Token and revocation forms authenticate from their own body, and the login_required browser routes reject an API key, so only the consent POST carries the uData X-API-KEY header."
  }
