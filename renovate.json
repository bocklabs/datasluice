{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    "schedule:daily"
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "timezone": "Europe/Luxembourg",
  "prConcurrentLimit": 5,
  "dependencyDashboard": true,
  "enabledManagers": [
    "github-actions",
    "pep621"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Lock file maintenance rewrites the whole lockfile, so the age gate would keep its branch pending forever.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pin",
        "digest",
        "minor",
        "patch"],
      "groupName": "GitHub Actions minor and patch updates",
      "automerge": true
    },
    {
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python minor and patch updates",
      "automerge": true
    },
    {
      "description": "Vendored upstream manifests under dev/ are frozen evidence for the local connector stacks; updates would desync them from the tracked upstream projects.",
      "matchFileNames": ["dev/**"],
      "enabled": false
    }
  ]
}
